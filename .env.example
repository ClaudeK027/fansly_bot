# Template de configuration utilisateur — copie ce fichier en `.env` et
# remplis avec tes propres valeurs.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Le fichier .env est gitignoré : il ne sera jamais committé ni embarqué
# dans l'image Docker. Le .env.example, lui, est versionné dans le repo
# pour servir de template.

# ─── Credentials Fansly ──────────────────────────────────────────────────
# Email / identifiant de connexion à Fansly (l'adresse que tu utilises
# pour te connecter sur le site).
FANSLY_USERNAME=ton.email@example.com

# Mot de passe Fansly. Recommandation forte : utilise un mot de passe
# unique pour Fansly. Si tu actives la 2FA côté Fansly, gère-la au moment
# du `setup-auth` (Chromium ouvert en mode interactif).
FANSLY_PASSWORD=ton_mot_de_passe

# ─── Identité du profil ──────────────────────────────────────────────────
# Slug de ton profil Fansly, visible dans l'URL publique de ta page.
# Exemple : si ton profil est https://fansly.com/MonPseudo/posts
# alors FANSLY_PROFILE_SLUG=MonPseudo
#
# Le bot utilise cette valeur pour naviguer sur ton profil lors des
# opérations de purge. Sans ce paramètre, il tombe sur le username
# (un email), qui ne fonctionne pas comme slug Fansly.
FANSLY_PROFILE_SLUG=MonPseudo

# ─── Options optionnelles ────────────────────────────────────────────────
# Chemin alternatif vers config.yaml (utile si tu déploies sur un VPS
# avec un layout système non standard).
# FANSLY_CONFIG_FILE=/etc/fansly-bot/config.yaml

# Contrôle si le worker se lance automatiquement au démarrage du container
# Docker. Décommenter et mettre à "false" pour démarrer le worker
# manuellement via le bouton "Lancer" du dashboard.
# AUTOSTART_WORKER=true
